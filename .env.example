DB_HOST=localhost
DB_PORT=5432
DB_NAME=cotu
DB_USER=cotu
DB_PASSWORD=suasenhaaqui

JWT_SECRET=suachavesecretaaquicomnominhode32caracteres
JWT_ISSUER=Cotu
JWT_AUDIENCE=CotuClients
JWT_EXPIRATION_MINUTES=480

# Multi-Tenancy (1 banco por cliente):
# O banco padrão é 'cotu'. Cada subdomínio se conecta ao seu banco: cotu_{subdominio} (ex: duna -> cotu_duna, staging -> cotu_staging)

# Seeds Iniciais do Sistema (Produção / Dev)
SEED_ADMIN_NAME=Administrador do Sistema
SEED_ADMIN_EMAIL=admin@cotu.com
SEED_ADMIN_PASSWORD=Admin@123

# Seeds de Desenvolvimento (Opcionais)
SEED_GERENTE_NAME=Gerente Arquiteto
SEED_GERENTE_EMAIL=gerente@cotu.com
SEED_GERENTE_PASSWORD=Gerente@123

SEED_COLABORADOR_NAME=Colaborador Arquiteto
SEED_COLABORADOR_EMAIL=colaborador@cotu.com
SEED_COLABORADOR_PASSWORD=Colaborador@123

# Configurações de Envio de E-mail (Hostinger / SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=seu-email@seudominio.com
SMTP_PASSWORD=sua-senha-de-email
SMTP_FROM_EMAIL=seu-email@seudominio.com
SMTP_FROM_NAME=Cotu
SMTP_ENABLE_SSL=true

# Google Calendar OAuth 2.0 (Obtido em Google Cloud Console > APIs & Serviços > Credenciais)
GOOGLE_CALENDAR_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=seu-client-secret

