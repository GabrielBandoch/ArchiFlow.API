# ==============================================================================
# VARIÁVEIS DE AMBIENTE DE PRODUÇÃO - COTU PLATFORM (HOSTINGER VPS)
# ==============================================================================

# 1. Domínio e Certificados SSL
# Informe o domínio configurado na Hostinger (sem subdomínio, ex: cotu.com.br ou meu-dominio.com)
DOMAIN_NAME=seu-dominio.com
ACME_EMAIL=seu-email@seudominio.com

# 2. Banco de Dados PostgreSQL (1 banco por cliente)
# O PostgreSQL criará automaticamente 'cotu' (base), 'cotu_staging' e 'cotu_duna'
DB_HOST=db
DB_PORT=5432
DB_NAME=cotu
DB_USER=cotu_admin
DB_PASSWORD=TroquePorUmaSenhaForteEMaisDe16Caracteres!2026

# 3. Segurança JWT
# A chave secreta DEVE possuir mais de 32 caracteres aleatórios
JWT_SECRET=GerarUmaChaveSecretaMuitoLongaESeguraAquiComMaisDe32Caracteres!
JWT_ISSUER=Cotu
JWT_AUDIENCE=CotuClients
JWT_EXPIRATION_MINUTES=480

# 4. Credenciais do Administrador Inicial (Criado automaticamente)
SEED_ADMIN_NAME=Administrador Geral
SEED_ADMIN_EMAIL=admin@cotu.com
SEED_ADMIN_PASSWORD=SenhaAdminForte@2026

# 5. Configuração de E-mail SMTP (Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=contato@seudominio.com
SMTP_PASSWORD=sua-senha-de-email-hostinger
SMTP_FROM_EMAIL=contato@seudominio.com
SMTP_FROM_NAME=Cotu
SMTP_ENABLE_SSL=true

# 6. Integração Google Calendar OAuth 2.0 (Opcional)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# 7. AWS Cloud Services - S3 Storage & SES Emails (Opcional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=seu-bucket-s3
AWS_SOURCE_EMAIL=contato@seudominio.com
